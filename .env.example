# Environment variables (copy to .env and fill in)
# Never commit .env — it is gitignored.

# Template update checker upstream (optional override)
# TEMPLATE_UPSTREAM=edwardlthompson/agent-project-bootstrap

# Project-specific variables (add below)
# API_BASE_URL=http://localhost:3000
# LOG_LEVEL=info

# Google Drive appdata sync (desktop/web). Copy to examples/web/.env.local
# Create a Desktop OAuth client with redirect http://127.0.0.1:17890
# VITE_DRIVE_CLIENT_ID=
# VITE_DRIVE_CLIENT_SECRET=
# VITE_DRIVE_PASSPHRASE=
# VITE_SEED_OPML_PATH=
