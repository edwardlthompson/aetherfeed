{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherfeed.org/schema/models.json",
  "title": "AetherFeed shared models",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "moduleKind": {
      "enum": ["news", "podcast", "booru"]
    },
    "readStatus": {
      "enum": ["unread", "in_progress", "read"]
    },
    "syncDocumentVersion": {
      "const": 1
    }
  }
}
