    "scale": {
      "titleLarge": { "sizeSp": 22, "sizeRem": 1.375, "lineHeight": 1.27, "weight": 400 },
      "headlineMedium": { "sizeSp": 28, "sizeRem": 1.75, "lineHeight": 1.2, "weight": 400 },
      "bodyLarge": { "sizeSp": 16, "sizeRem": 1.0, "lineHeight": 1.5, "weight": 400 },
      "bodyMedium": { "sizeSp": 14, "sizeRem": 0.875, "lineHeight": 1.43, "weight": 400 },
      "labelLarge": { "sizeSp": 14, "sizeRem": 0.875, "lineHeight": 1.43, "weight": 500 }
    }
