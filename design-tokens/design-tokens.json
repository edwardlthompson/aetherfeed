{
  "meta": {
    "name": "AetherFeed",
    "themeColorLight": "#F7F6F2",
    "themeColorDark": "#12161A"
  },
  "color": {
    "primary": { "light": "#3D5A6C", "dark": "#8FB4C7" },
    "onPrimary": { "light": "#FFFFFF", "dark": "#12161A" },
    "primaryContainer": { "light": "#D5E3EB", "dark": "#2A3F4C" },
    "onPrimaryContainer": { "light": "#122028", "dark": "#D5E3EB" },
    "secondary": { "light": "#5C6B5A", "dark": "#A8B6A4" },
    "onSecondary": { "light": "#FFFFFF", "dark": "#12161A" },
    "secondaryContainer": { "light": "#DDE6D8", "dark": "#3A4538" },
    "onSecondaryContainer": { "light": "#1A2118", "dark": "#DDE6D8" },
    "tertiary": { "light": "#6A5E52", "dark": "#C9B8A6" },
    "onTertiary": { "light": "#FFFFFF", "dark": "#12161A" },
    "error": { "light": "#BA1A1A", "dark": "#FFB4AB" },
    "onError": { "light": "#FFFFFF", "dark": "#690005" },
    "background": { "light": "#F7F6F2", "dark": "#12161A" },
    "onBackground": { "light": "#1A1F24", "dark": "#E6E4DC" },
    "surface": { "light": "#F1F0EB", "dark": "#1A1F24" },
